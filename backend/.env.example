# FloatChat AI Backend Configuration

# Server
PORT=5001
NODE_ENV=development

# Session Authentication
# Secure random string (minimum 32 characters) for signing auth session tokens
SESSION_SECRET=floatchat_super_secure_session_secret_key_at_least_32_characters_long

# Oceanographic Data - Argovis API Key
# Register at: https://argovis-keygen.colorado.edu/
ARGOVIS_API_KEY=

# AI Assistant - Google Gemini API Key
# Generate at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Emergency Alerts - Twilio REST API
# Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
ALERT_RECIPIENT_PHONE=

# Database Configuration (Optional: SQLite is primary and auto-configured)
# MONGODB_URI=mongodb://localhost:27017/floatchat
